@{
}
@model IList<ElasticSentinel.Application.Common.Models.QuartzJob>
<table class="table table-hover">
    <thead>
        <tr>
            <th>Job Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model)
        {
            <tr>
                <td>job.JobName</td>
            </tr>
        }
    </tbody>
</table>
