@page
@model ElasticSentinel.Pages.Queries.QuerySource.EditModel

<div class="pagetitle">
    <h1>Query Source</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Home">Home</a></li>
            <li class="breadcrumb-item">KQL Queries</li>
            <li class="breadcrumb-item active"><a href="/Queries/QuerySource/Index">Query Source</a></li>
            <li class="breadcrumb-item active">Edit</li>
        </ol>
    </nav>
</div>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ElasticDynamicQuerySource.ElasticDynamicQuerySourceId" />
            <div class="form-group">
                <label asp-for="ElasticDynamicQuerySource.SourceName" class="control-label"></label>
                <input asp-for="ElasticDynamicQuerySource.SourceName" class="form-control" />
                <span asp-validation-for="ElasticDynamicQuerySource.SourceName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQuerySource.SourceQuery" class="control-label"></label>
                <textarea asp-for="ElasticDynamicQuerySource.SourceQuery" class="form-control" rows="20"></textarea>
                <span asp-validation-for="ElasticDynamicQuerySource.SourceQuery" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQuerySource.SourceType" class="control-label"></label>
                <input asp-for="ElasticDynamicQuerySource.SourceType" class="form-control" />
                <span asp-validation-for="ElasticDynamicQuerySource.SourceType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
