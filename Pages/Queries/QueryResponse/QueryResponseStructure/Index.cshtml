@page
@model ElasticSentinel.Pages.Queries.QueryResponse.QueryResponseStructure.IndexModel

<div class="pagetitle">
    <h1>Query Response Structure</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Home">Home</a></li>
            <li class="breadcrumb-item">KQL Queries</li>
            <li class="breadcrumb-item active">Query Response Structure</li>
        </ol>
    </nav>
</div>
<hr />
<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ElasticDynamicQueryResponseStructure[0].IsIndexFieldAnArray)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ElasticDynamicQueryResponseStructure[0].IndexRootFieldName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ElasticDynamicQueryResponseStructure[0].IndexFieldName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ElasticDynamicQueryResponseStructure[0].AliasFieldName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ElasticDynamicQueryResponseStructure[0].DynamicQueryResponseDetail)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ElasticDynamicQueryResponseStructure)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IsIndexFieldAnArray)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IndexRootFieldName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IndexFieldName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AliasFieldName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DynamicQueryResponseDetail.QueryResponseMapperName)
                </td>
                <td>
                    <a class="btn btn-outline-primary btn-sm rounded-0" type="button" asp-page="./Edit" asp-route-id="@item.ElasticDynamicQueryResponseStructureId"><i class="bx bx-edit" title="Edit"></i></a> |
                    <a class="btn btn-outline-success btn-sm rounded-0" type="button" asp-page="./Details" asp-route-id="@item.ElasticDynamicQueryResponseStructureId"><i class="bx bx-detail" title="Details"></i></a>
                    <a class="btn btn-outline-danger btn-sm rounded-0" type="button" asp-page="./Delete" asp-route-id="@item.ElasticDynamicQueryResponseStructureId"><i class="bx bx-trash" title="Delete"></a>
                </td>
            </tr>
        }
    </tbody>
</table>
