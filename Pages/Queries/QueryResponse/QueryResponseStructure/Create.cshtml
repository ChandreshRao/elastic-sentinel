@page
@model ElasticSentinel.Pages.Queries.QueryResponse.QueryResponseStructure.CreateModel


<div class="pagetitle">
    <h1>Query Response Structure</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Home">Home</a></li>
            <li class="breadcrumb-item">KQL Queries</li>
            <li class="breadcrumb-item"><a href="/Queries/QueryResponse/QueryResponseStructure/Index">Query Response Structure</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>
</div>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryResponseStructure.ElasticDynamicQueryResponseDetailId" class="control-label"></label>
                <select asp-for="ElasticDynamicQueryResponseStructure.ElasticDynamicQueryResponseDetailId" class="form-control" asp-items="ViewBag.ElasticDynamicQueryResponseDetailId"></select>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="ElasticDynamicQueryResponseStructure.IsIndexFieldAnArray" /> @Html.DisplayNameFor(model => model.ElasticDynamicQueryResponseStructure.IsIndexFieldAnArray)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryResponseStructure.IndexRootFieldName" class="control-label"></label>
                <input asp-for="ElasticDynamicQueryResponseStructure.IndexRootFieldName" class="form-control" />
                <span asp-validation-for="ElasticDynamicQueryResponseStructure.IndexRootFieldName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryResponseStructure.IndexFieldName" class="control-label"></label>
                <input asp-for="ElasticDynamicQueryResponseStructure.IndexFieldName" class="form-control" />
                <span asp-validation-for="ElasticDynamicQueryResponseStructure.IndexFieldName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryResponseStructure.AliasFieldName" class="control-label"></label>
                <input asp-for="ElasticDynamicQueryResponseStructure.AliasFieldName" class="form-control" />
                <span asp-validation-for="ElasticDynamicQueryResponseStructure.AliasFieldName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
