@page
@model ElasticSentinel.Pages.Queries.QueryRequest.EditModel

<div class="pagetitle">
    <h1>Query Request</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Home">Home</a></li>
            <li class="breadcrumb-item">KQL Queries</li>
            <li class="breadcrumb-item"><a href="/Queries/QueryRequest/Index">Query Request</a></li>
            <li class="breadcrumb-item active">Edit</li>
        </ol>
    </nav>
</div>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ElasticDynamicQueryRequestDetail.ElasticDynamicQueryDetailId" />
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryRequestDetail.DyanmicQueryName" class="control-label"></label>
                <input asp-for="ElasticDynamicQueryRequestDetail.DyanmicQueryName" class="form-control" />
                <span asp-validation-for="ElasticDynamicQueryRequestDetail.DyanmicQueryName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryRequestDetail.HTTPMethod" class="control-label"></label>
                <input asp-for="ElasticDynamicQueryRequestDetail.HTTPMethod" class="form-control" />
                <span asp-validation-for="ElasticDynamicQueryRequestDetail.HTTPMethod" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryRequestDetail.IndexName" class="control-label"></label>
                <input asp-for="ElasticDynamicQueryRequestDetail.IndexName" class="form-control" />
                <span asp-validation-for="ElasticDynamicQueryRequestDetail.IndexName" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="ElasticDynamicQueryRequestDetail.IsIndexNameExpression" /> @Html.DisplayNameFor(model => model.ElasticDynamicQueryRequestDetail.IsIndexNameExpression)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryRequestDetail.QueryType" class="control-label"></label>
                <input asp-for="ElasticDynamicQueryRequestDetail.QueryType" class="form-control" />
                <span asp-validation-for="ElasticDynamicQueryRequestDetail.QueryType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryRequestDetail.QueryParams" class="control-label"></label>
                <input asp-for="ElasticDynamicQueryRequestDetail.QueryParams" class="form-control" />
                <span asp-validation-for="ElasticDynamicQueryRequestDetail.QueryParams" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryRequestDetail.ElasticDynamicQuerySourceId" class="control-label"></label>
                <select asp-for="ElasticDynamicQueryRequestDetail.ElasticDynamicQuerySourceId" class="form-control" asp-items="ViewBag.ElasticDynamicQuerySourceId"></select>
                <span asp-validation-for="ElasticDynamicQueryRequestDetail.ElasticDynamicQuerySourceId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryRequestDetail.Headers" class="control-label"></label>
                <input asp-for="ElasticDynamicQueryRequestDetail.Headers" class="form-control" />
                <span asp-validation-for="ElasticDynamicQueryRequestDetail.Headers" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryRequestDetail.AuthType" class="control-label"></label>
                <input asp-for="ElasticDynamicQueryRequestDetail.AuthType" class="form-control" />
                <span asp-validation-for="ElasticDynamicQueryRequestDetail.AuthType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ElasticDynamicQueryRequestDetail.Body" class="control-label"></label>
                <input asp-for="ElasticDynamicQueryRequestDetail.Body" class="form-control" />
                <span asp-validation-for="ElasticDynamicQueryRequestDetail.Body" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
