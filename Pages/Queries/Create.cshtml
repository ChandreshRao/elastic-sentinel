@page
@model ElasticSentinel.Pages.Queries.CreateModel


<div class="pagetitle">
    <h1>KQL Queries</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Home">Home</a></li>
            <li class="breadcrumb-item"><a href="/Queries/Index">KQL Queries</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>
</div>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ElasticQuery.QueryName" class="control-label"></label>
                <input asp-for="ElasticQuery.QueryName" class="form-control" />
                <span asp-validation-for="ElasticQuery.QueryName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ElasticQuery.QueryDescription" class="control-label"></label>
                <input asp-for="ElasticQuery.QueryDescription" class="form-control" />
                <span asp-validation-for="ElasticQuery.QueryDescription" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="ElasticQuery.IsDynamic" /> @Html.DisplayNameFor(model => model.ElasticQuery.IsDynamic)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
