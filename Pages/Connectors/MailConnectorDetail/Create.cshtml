@page
@model ElasticSentinel.Pages.Connectors.MailConnectorDetail.CreateModel

<div class="pagetitle">
    <h1>Email Recipients</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Home">Home</a></li>
            <li class="breadcrumb-item">Notification Connectors</li>
            <li class="breadcrumb-item active"><a href="/Connectors/MailConnectorDetail">Email Recipients</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>
</div>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="EmailConnectorDetail.Name" class="control-label"></label>
                <input asp-for="EmailConnectorDetail.Name" class="form-control" />
                <span asp-validation-for="EmailConnectorDetail.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmailConnectorDetail.EmailSubject" class="control-label"></label>
                <input asp-for="EmailConnectorDetail.EmailSubject" class="form-control" />
                <span asp-validation-for="EmailConnectorDetail.EmailSubject" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmailConnectorDetail.ToEmails" class="control-label"></label>
                <textarea asp-for="EmailConnectorDetail.ToEmails" class="form-control"></textarea>
                <span asp-validation-for="EmailConnectorDetail.ToEmails" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmailConnectorDetail.CcEmails" class="control-label"></label>
                <textarea asp-for="EmailConnectorDetail.CcEmails" class="form-control"></textarea>
                <span asp-validation-for="EmailConnectorDetail.CcEmails" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
