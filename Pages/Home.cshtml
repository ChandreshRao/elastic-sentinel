    //connection.on("ElasticQueryManagerJob", function (message) {
    //    latestMessageContent.innerHTML = message;
    //    $("#latest-message").fadeIn().delay(5000).fadeOut();
    //});

    connection.on("ElasticSentinelJob", function (currentDtTm, message) {
        appendMessages(currentDtTm, message);
    });
    function appendMessages(currentDtTm, message) {
        const textStyles = ["text-success", "text-danger", "text-primary", "text-dark", "text-warning"];
        var divAct = document.getElementById('divActivity');
        var textStyle = textStyles[Math.floor(Math.random() * textStyles.length)];
        var divInner = document.createElement('div');
        divInner.className = "activity-item d-flex";
        divInner.innerHTML = `<div class="activite-label">${currentDtTm}</div><i class= "bi bi-circle-fill activity-badge ${textStyle} align-self-start"></i><div class="activity-content"> ${message}</div>`;
        divAct.prepend(divInner);
        const threshold = 10;
        if (divAct.children.length > threshold) {
            for (let i = threshold; i < divAct.children.length; i++) {
                divAct.children[i].remove(); // remove the child element
            }
        }
    }
</script>
