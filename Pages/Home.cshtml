@page
@model HomeModel
@{
    ViewData["Title"] = "Home page";
}

<div class="pagetitle">
    <h1>Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Home">Home</a></li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
</div>
<hr />
<section class="section dashboard">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Recent Activity</h5>
            <div id="divActivity" class="activity">
            </div>
        </div>
    </div>
</section>

<script src="~/lib/microsoft-signalr/signalr.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/jobshub")
        .configureLogging(signalR.LogLevel.Information)
        .build();

    async function start() {
        try {
            await connection.start();
            console.log("SignalR Connected.");
        } catch (err) {
            console.log(err);
            setTimeout(start, 5000);
        }
    };

    connection.onclose(async () => {
        await start();
    });

    start();

    //connection.on("AlertSchedulerJob", function (message) {
    //    var li = document.createElement("li");
    //    document.getElementById("alert-schedule").appendChild(li);
    //    li.textContent = `${message}`;
    //});

    //connection.on("ElasticQueryManagerJob", function (message) {
    //    var li = document.createElement("li");
    //    document.getElementById("elasticquery-alert").appendChild(li);
