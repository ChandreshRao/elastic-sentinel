@page
@model ElasticSentinel.Pages.AlertMessageTemplates.IndexModel

<div class="pagetitle">
    <h1>Alert Message Templates</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Home">Home</a></li>
            <li class="breadcrumb-item active">Alert Message Templates</li>
        </ol>
    </nav>
</div>
<hr />
<p>
    <a asp-page="Create" class="btn btn-primary" role="button">Create New</a>
</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NotificationTemplate[0].TemplateName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NotificationTemplate[0].TemplateContent)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NotificationTemplate[0].IsEnabled)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.NotificationTemplate.Count; i++)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => Model.NotificationTemplate[i].TemplateName)
                </td>
                <td>
                    @*@Html.DisplayFor(modelItem => item.TemplateContent)*@
                    <partial name="_HtmlTemplateView" model="@Model.NotificationTemplate[i]" />
                </td>
                <td>
                    @Html.DisplayFor(modelItem => Model.NotificationTemplate[i].IsEnabled)
                </td>
                <td>
                    <a class="btn btn-outline-primary btn-sm rounded-0" type="button" asp-page="./Edit" asp-route-id="@Model.NotificationTemplate[i].NotificationTemplateId"><i class="bx bx-edit" title="Edit"></i></a> |
                    <a class="btn btn-outline-success btn-sm rounded-0" type="button" asp-page="./Details" asp-route-id="@Model.NotificationTemplate[i].NotificationTemplateId"><i class="bx bx-detail" title="Details"></i></a> |
                    <a class="btn btn-outline-danger btn-sm rounded-0" type="button"  asp-page="./Delete" asp-route-id="@Model.NotificationTemplate[i].NotificationTemplateId"><i class="bx bx-trash" title="Delete"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    function htmlDecode(input) {
        var e = document.createElement('textarea');
        e.innerHTML = input;
        // handle case of empty input
        return e.childNodes.length === 0 ? "" : e.childNodes[0].nodeValue;
    }

    function formatElement() {
        for (var i = 0; i < document.getElementsByClassName('divTemplate').length; i++) {
            var div = document.getElementsByClassName('divTemplate')[i];
            var str = div.innerHTML;
            div.innerHTML = htmlDecode(str);
        }
    }
    formatElement();

</script>
