        <h1>Elasticsearch Settings</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Home">Home</a></li>
                <li class="breadcrumb-item"><a href="/ElasticSearchSettings/Index">Elasticsearch Settings</a></li>
                <li class="breadcrumb-item active">Details</li>
            </ol>
        </nav>
    </div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ElasticConfiguration.ClusterName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ElasticConfiguration.ClusterName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ElasticConfiguration.ElasticHost)
