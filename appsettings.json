{
  "ConnectionStrings": {
    "SentinelDb": "Data source=datasource/ElasticSentinel.db"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "using": [ "Serilog.Sinks.File" ],
    "Minimumlevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "Path": "logs/sentinelLog-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}]"
        }
      }
    ]
  },
  "Auth": {
    "ApiKey": "test-api-key"
  }
}
